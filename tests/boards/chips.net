(export (version "E")
 (design (source "chips.kicad_sch") (tool "hand-written test board for circuit.py"))
 (components
  (comp (ref "U1") (value "STM32F103C8Tx") (libsource (lib "MCU_ST_STM32F1") (part "STM32F103C8Tx") (description "")))
  (comp (ref "U2") (value "RP2040") (libsource (lib "MCU_RaspberryPi") (part "RP2040") (description "")))
  (comp (ref "U3") (value "ATmega328P-AU") (libsource (lib "MCU_Microchip_ATmega") (part "ATmega328P-AU") (description "")))
  (comp (ref "U4") (value "nRF52832-QFxx") (libsource (lib "MCU_Nordic") (part "nRF52832-QFxx") (description "")))
  (comp (ref "U5") (value "ATSAMD21G18A-A") (libsource (lib "MCU_Microchip_SAMD") (part "ATSAMD21G18A-A") (description "")))
  (comp (ref "U6") (value "ESP-12E") (libsource (lib "RF_Module") (part "ESP-12E") (description "")))
  (comp (ref "J1") (value "SWD") (libsource (lib "Connector") (part "Conn_01x04") (description "")))
  (comp (ref "J2") (value "Conn_01x03") (libsource (lib "Connector") (part "Conn_01x03") (description "")))
  (comp (ref "J3") (value "Conn_01x06") (libsource (lib "Connector") (part "Conn_01x06") (description "")))
  (comp (ref "J4") (value "Conn_01x04") (libsource (lib "Connector") (part "Conn_01x04") (description "")))
  (comp (ref "SW1") (value "BOOT") (libsource (lib "Switch") (part "SW_Push") (description "")))
  (comp (ref "SW2") (value "BOOTSEL") (libsource (lib "Switch") (part "SW_Push") (description "")))
  (comp (ref "SW3") (value "FLASH") (libsource (lib "Switch") (part "SW_Push") (description ""))))
 (nets
  (net (code "1") (name "Net-(U1-PA13)")
   (node (ref "U1") (pin "34") (pinfunction "PA13") (pintype "bidirectional")) (node (ref "J1") (pin "1") (pintype "passive")))
  (net (code "2") (name "Net-(U1-PA14)")
   (node (ref "U1") (pin "37") (pinfunction "PA14") (pintype "bidirectional")) (node (ref "J1") (pin "2") (pintype "passive")))
  (net (code "3") (name "Net-(U1-BOOT0)")
   (node (ref "U1") (pin "44") (pinfunction "BOOT0") (pintype "input")) (node (ref "SW1") (pin "1") (pintype "passive")))
  (net (code "4") (name "Net-(U1-PA9)")
   (node (ref "U1") (pin "30") (pinfunction "PA9") (pintype "bidirectional")) (node (ref "J2") (pin "1") (pintype "passive")))
  (net (code "5") (name "Net-(U2-GPIO10)")
   (node (ref "U2") (pin "13") (pinfunction "GPIO10") (pintype "bidirectional")) (node (ref "J2") (pin "2") (pintype "passive")))
  (net (code "6") (name "Net-(U2-QSPI_SS)")
   (node (ref "U2") (pin "56") (pinfunction "QSPI_SS") (pintype "bidirectional")) (node (ref "SW2") (pin "1") (pintype "passive")))
  (net (code "7") (name "Net-(U2-SWCLK)")
   (node (ref "U2") (pin "24") (pinfunction "SWCLK") (pintype "input")) (node (ref "J1") (pin "3") (pintype "passive")))
  (net (code "8") (name "Net-(U3-PB3)")
   (node (ref "U3") (pin "15") (pinfunction "PB3") (pintype "bidirectional")) (node (ref "J3") (pin "1") (pintype "passive")))
  (net (code "9") (name "Net-(U3-PC6)")
   (node (ref "U3") (pin "29") (pinfunction "PC6") (pintype "bidirectional")) (node (ref "J3") (pin "2") (pintype "passive")))
  (net (code "10") (name "Net-(U4-SWDCLK)")
   (node (ref "U4") (pin "24") (pinfunction "SWDCLK") (pintype "input")) (node (ref "J4") (pin "1") (pintype "passive")))
  (net (code "11") (name "Net-(U5-PA30)")
   (node (ref "U5") (pin "45") (pinfunction "PA30") (pintype "bidirectional")) (node (ref "J4") (pin "2") (pintype "passive")))
  (net (code "12") (name "Net-(U6-GPIO0)")
   (node (ref "U6") (pin "18") (pinfunction "GPIO0") (pintype "bidirectional")) (node (ref "SW3") (pin "1") (pintype "passive")))
  (net (code "13") (name "Net-(U6-TXD)")
   (node (ref "U6") (pin "22") (pinfunction "TXD") (pintype "output")) (node (ref "J4") (pin "3") (pintype "passive")))
  (net (code "14") (name "GND")
   (node (ref "U1") (pin "47") (pinfunction "VSS") (pintype "power_in"))
   (node (ref "SW1") (pin "2") (pintype "passive")) (node (ref "SW2") (pin "2") (pintype "passive"))
   (node (ref "SW3") (pin "2") (pintype "passive")) (node (ref "J4") (pin "4") (pintype "passive")))))
