(export (version "E")
 (design (source "cellular.kicad_sch") (tool "hand-written test board for circuit.py"))
 (components
  (comp (ref "U1") (value "BG95-M3") (libsource (lib "RF_GSM") (part "BG95-M3") (description "")))
  (comp (ref "U2") (value "SIM800C") (libsource (lib "RF_GSM") (part "SIM800C") (description "")))
  (comp (ref "U3") (value "BC95") (libsource (lib "RF_GSM") (part "BC95") (description "")))
  (comp (ref "U4") (value "MFF2 eSIM") (libsource (lib "Custom") (part "eSIM_MFF2") (description "Embedded SIM")))
  (comp (ref "U6") (value "M95M02-DR") (libsource (lib "Memory_EEPROM") (part "M95M02-DR") (description "SPI EEPROM")))
  (comp (ref "Q1") (value "BC547") (libsource (lib "Transistor_BJT") (part "BC547") (description "NPN transistor")))
  (comp (ref "AE1") (value "GSM antenna") (libsource (lib "Device") (part "Antenna") (description "GSM antenna")))
  (comp (ref "R1") (value "22R") (libsource (lib "Device") (part "R") (description "Resistor")))
  (comp (ref "J1") (value "USB_B_Micro") (libsource (lib "Connector") (part "USB_B_Micro") (description "")))
  (comp (ref "J2") (value "SIM_Card") (libsource (lib "Connector") (part "SIM_Card") (description "")))
  (comp (ref "J3") (value "Conn_01x03") (libsource (lib "Connector") (part "Conn_01x03") (description "")))
  (comp (ref "TP1") (value "TestPoint") (libsource (lib "Connector") (part "TestPoint") (description "")))
  (comp (ref "TP2") (value "TestPoint") (libsource (lib "Connector") (part "TestPoint") (description ""))))
 (nets
  (net (code "1") (name "MODEM_USB_DP")
   (node (ref "U1") (pin "10") (pinfunction "USB_DP") (pintype "bidirectional")) (node (ref "J1") (pin "3") (pinfunction "D+") (pintype "bidirectional")))
  (net (code "2") (name "MODEM_USB_DM")
   (node (ref "U1") (pin "11") (pinfunction "USB_DM") (pintype "bidirectional")) (node (ref "J1") (pin "2") (pinfunction "D-") (pintype "bidirectional")))
  (net (code "3") (name "Net-(U1-USB_BOOT)")
   (node (ref "U1") (pin "75") (pinfunction "USB_BOOT") (pintype "input")) (node (ref "TP1") (pin "1") (pintype "passive")))
  (net (code "4") (name "Net-(U1-USIM_DATA)")
   (node (ref "U1") (pin "16") (pinfunction "USIM_DATA") (pintype "bidirectional")) (node (ref "R1") (pin "1") (pintype "passive")))
  (net (code "5") (name "SIM_IO")
   (node (ref "R1") (pin "2") (pintype "passive")) (node (ref "J2") (pin "7") (pinfunction "I/O") (pintype "passive")))
  (net (code "6") (name "Net-(U2-UART1_TXD)")
   (node (ref "U2") (pin "1") (pinfunction "UART1_TXD") (pintype "output")) (node (ref "J3") (pin "1") (pintype "passive")))
  (net (code "7") (name "Net-(U2-SIM_DATA)")
   (node (ref "U2") (pin "15") (pinfunction "SIM_DATA") (pintype "bidirectional")) (node (ref "U4") (pin "3") (pinfunction "I/O") (pintype "bidirectional")))
  (net (code "8") (name "Net-(U3-DBG_TXD)")
   (node (ref "U3") (pin "38") (pinfunction "DBG_TXD") (pintype "output")) (node (ref "TP2") (pin "1") (pintype "passive")))
  (net (code "9") (name "GND")
   (node (ref "U1") (pin "1") (pinfunction "GND") (pintype "power_in")) (node (ref "Q1") (pin "2") (pinfunction "E") (pintype "passive"))
   (node (ref "U6") (pin "4") (pinfunction "VSS") (pintype "power_in")) (node (ref "AE1") (pin "1") (pintype "passive")))))
